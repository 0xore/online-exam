# Copy this file to .env.local for development.
# On Vercel, set the same names in Project → Settings → Environment Variables.
# Never commit real keys.

# Required. Project URL from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Required. Anon / public key from the same API page.
# Safe for the browser and Vercel. Row Level Security and SECURITY DEFINER
# RPCs restrict what candidates can read and write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Service role key. This app does not read it.
# Do not add it to Vercel or any client bundle.
# Keep it in the Supabase dashboard or a local CLI profile only.
SUPABASE_SERVICE_ROLE_KEY=
